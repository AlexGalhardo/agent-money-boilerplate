{
	"name": "elysia-galhardo-finances",
	"private": true,
	"version": "0.0.1-alpha",
	"license": "MIT",
	"workspaces": [
		"backend",
		"frontend",
		"bot",
		"mobile"
	],
	"scripts": {
		"backend:dev": "bun run --cwd backend dev",
		"backend:build": "bun run --cwd backend build",
		"backend:test": "bun run --cwd backend test",
		"frontend:dev": "bun run --cwd frontend dev",
		"frontend:build": "bun run --cwd frontend build",
		"bot:dev": "bun run --cwd bot dev",
		"bot:test": "bun run --cwd bot test",
		"mobile:dev": "bun run --cwd mobile start",
		"mobile:test": "bun run --cwd mobile test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck:backend": "bun run --cwd backend tsc --noEmit",
		"typecheck:frontend": "bun run --cwd frontend tsc --noEmit",
		"typecheck:bot": "bun run --cwd bot tsc --noEmit",
		"typecheck:mobile": "bun run --cwd mobile tsc --noEmit",
		"docker:sqlite:up": "docker compose -f docker-compose.sqlite.yml up -d --build",
		"docker:sqlite:down": "docker compose -f docker-compose.sqlite.yml down",
		"docker:postgres:up": "docker compose up -d --build",
		"docker:postgres:down": "docker compose down",
		"pm2:start": "pm2 start ecosystem.local.config.js --only elysia-backend,elysia-frontend",
		"pm2:start:bot": "pm2 start ecosystem.local.config.js --only elysia-bot",
		"pm2:stop": "pm2 stop ecosystem.local.config.js",
		"pm2:restart": "pm2 restart ecosystem.local.config.js",
		"pm2:delete": "pm2 delete ecosystem.local.config.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"husky": "9.1.7",
		"typescript": "7.0.2"
	}
}
