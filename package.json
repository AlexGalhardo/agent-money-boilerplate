{
	"name": "agentic-personal-finances",
	"private": true,
	"type": "module",
	"version": "1.2.0",
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"workspaces": [
		"backend",
		"frontend",
		"bot",
		"mobile",
		"desktop",
		"packages/*"
	],
	"scripts": {
		"backend:dev": "bun run --cwd backend dev",
		"backend:build": "bun run --cwd backend build",
		"backend:test": "bun run --cwd backend test",
		"frontend:dev": "bun run --cwd frontend dev",
		"frontend:build": "bun run --cwd frontend build",
		"frontend:test": "bun run --cwd frontend test",
		"bot:dev": "bun run --cwd bot dev",
		"bot:test": "bun run --cwd bot test",
		"mobile:dev": "bun run --cwd mobile start",
		"mobile:test": "bun run --cwd mobile test",
		"desktop:dev": "bun run --cwd desktop start",
		"desktop:smoke": "bun run --cwd desktop smoke",
		"desktop:dist": "bun run --cwd desktop dist",
		"dev:all": "bun scripts/dev.ts",
		"build": "bun scripts/standalone/build.ts",
		"build:standalone": "bun scripts/standalone/build.ts",
		"qa": "bun scripts/qa.ts --start",
		"lint": "biome check . && bun run lint:md && bun run check:deps",
		"lint:md": "markdownlint-cli2 && prettier --check \"**/*.md\"",
		"lint:fix": "biome check --write . && markdownlint-cli2 --fix && prettier --write \"**/*.md\"",
		"format": "biome format --write . && prettier --write \"**/*.md\"",
		"check:deps": "bun scripts/check-dependency-rule.ts",
		"test:scripts": "bun test scripts/check-dependency-rule.test.ts",
		"typecheck:backend": "bun check --no-script -p backend",
		"typecheck:frontend": "bun check --no-script -p frontend",
		"typecheck:bot": "bun check --no-script -p bot",
		"typecheck:mobile": "bun check --no-script -p mobile",
		"typecheck:desktop": "bun check --no-script -p desktop",
		"typecheck:core": "bun check --no-script -p packages/core",
		"typecheck:scripts": "bun check --no-script -p scripts",
		"typecheck": "bun check --no-script -p backend -p frontend -p bot -p mobile -p desktop -p packages/core -p scripts",
		"test": "bun run backend:test && bun run bot:test && bun run frontend:test && bun run mobile:test && bun test packages/core",
		"check": "bun run lint && bun run typecheck && bun run test && bun run test:scripts",
		"docker:sqlite:up": "docker compose -f infra/docker-compose.sqlite.yml --project-directory . up -d --build",
		"docker:sqlite:down": "docker compose -f infra/docker-compose.sqlite.yml --project-directory . down",
		"docker:postgres:up": "docker compose -f infra/docker-compose.yml --project-directory . up -d --build",
		"docker:postgres:down": "docker compose -f infra/docker-compose.yml --project-directory . down",
		"pm2:start": "pm2 start infra/ecosystem.local.config.js --only elysia-backend,elysia-frontend",
		"pm2:start:bot": "pm2 start infra/ecosystem.local.config.js --only elysia-bot",
		"pm2:stop": "pm2 stop infra/ecosystem.local.config.js",
		"pm2:restart": "pm2 restart infra/ecosystem.local.config.js",
		"pm2:delete": "pm2 delete infra/ecosystem.local.config.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.65.0",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.10",
		"railway": "^3.16.0",
		"typescript": "7.0.2"
	},
	"patchedDependencies": {
		"nativewind@4.2.7": "patches/nativewind@4.2.7.patch"
	}
}
