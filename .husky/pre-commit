set -e

# Já aconteceu mais de uma vez de um binário compilado (bun build --compile,
# ~90MB) ser commitado por engano — bloqueia isso na raiz em vez de confiar
# só no .gitignore.
staged_exes=$(git diff --cached --name-only --diff-filter=ACM | grep -i '\.exe$' || true)
if [ -n "$staged_exes" ]; then
	echo "Commit bloqueado: arquivo(s) .exe staged — nunca deveriam ir pro git:" >&2
	echo "$staged_exes" >&2
	exit 1
fi

if git diff --cached --name-only | grep -qx "bun.lock"; then
	lockfile_version=$(grep -m1 '"lockfileVersion"' bun.lock | grep -o '[0-9]\+')
	if [ "$lockfile_version" != "1" ]; then
		echo "bun.lock está com lockfileVersion $lockfile_version, mas o build do mobile na EAS usa bun 1.3.14, que só entende lockfileVersion 1." >&2
		echo "Regenere o lockfile com uma versão de bun compatível: npx bun@1.3.14 install" >&2
		exit 1
	fi
fi

bun run format
bun run lint
