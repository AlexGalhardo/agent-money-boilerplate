# Build context = repo root (shared by every image). Keep it lean but DO ship
# backend/, mobile/ and shared/ sources.
**/node_modules
**/.expo
**/dist
**/web-build
**/coverage
**/.next
**/.turbo
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.tsbuildinfo

# Never bake local secrets into an image
**/.env
**/.env.*
!**/.env.example

# VCS / editor / CI noise
.git
.github
.vscode
.idea
**/*.log

# Native output and E2E
mobile/ios
mobile/android
e2e
