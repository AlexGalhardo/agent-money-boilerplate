# =============================================================================
#  op — single env file for the Docker stack (docker-compose.yml).
#  Copy to `.env` at the repo root (`cp .env.example .env`) and edit.
#  Docker Compose auto-loads `./.env` on every command — no flags, same on
#  Windows and Unix.
#
#  The per-package files (backend/.env, mobile/.env) are only for running
#  WITHOUT Docker. This file replaces both when you use the stack.
# =============================================================================

# ---------------------------------------------------------------------------
#  Host ports (change if something is already listening)
# ---------------------------------------------------------------------------
WEB_PORT=8081          # the app (Expo web build, served by nginx)
BACKEND_PORT=3333      # the API, also exposed directly (native app + webhooks)
METRO_PORT=8082        # only used by the `native` profile (device testing)
DB_PORT=5432           # only exposed in dev (docker-compose.override.yml)

# ---------------------------------------------------------------------------
#  Database
#  - POSTGRES_* configure the bundled `db` container.
#  - DATABASE_URL is what the backend connects to. For the bundled db it must
#    match POSTGRES_* (host = the service name `db`). For a managed database
#    (RDS/Neon/…), set DATABASE_URL to it and run `docker compose up -d backend web`.
# ---------------------------------------------------------------------------
POSTGRES_USER=op
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=op
DATABASE_URL=postgres://op:change-me-please@db:5432/op

# ---------------------------------------------------------------------------
#  Backend runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
# Public URL the API is reachable at (used in emails + Stripe return URLs).
# Local: http://localhost:3333 . Prod: https://api.seudominio.com
APP_URL=http://localhost:3333
# Public URL of the app itself (deep links in emails point here).
# Local: http://localhost:8081 . Prod: https://app.seudominio.com
WEB_APP_URL=http://localhost:8081

# openssl rand -base64 48   (generate NEW values for production!)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ---------------------------------------------------------------------------
#  Google sign-in (optional). OAuth 2.0 Web Client ID from
#  https://console.cloud.google.com/apis/credentials — must match the audience
#  of the ID token the app sends.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
#  Email (Resend). https://resend.com/api-keys
#  Leave EMAIL_DRY_RUN=true to log emails to the container logs instead of
#  sending (no key needed). Set to false + a real key for production.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=op <no-reply@seudominio.com>
EMAIL_DRY_RUN=true

# ---------------------------------------------------------------------------
#  Stripe — card subscriptions. Test keys: https://dashboard.stripe.com/test/apikeys
#  Create ONE recurring Price per plan+currency in the dashboard and paste the
#  price_... ids below. Webhook secret: from `stripe listen` locally, or the
#  endpoint's signing secret in the dashboard for prod. Webhook URL in prod:
#  https://api.seudominio.com/v1/webhooks/stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_BRL=
STRIPE_PRICE_ANNUAL_BRL=
STRIPE_PRICE_MONTHLY_USD=
STRIPE_PRICE_ANNUAL_USD=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ---------------------------------------------------------------------------
#  AbacatePay — PIX. Sandbox key from https://app.abacatepay.com
#  Webhook secret = the `secret` you set when registering the webhook
#  (POST /webhooks/create). Webhook URL in prod:
#  https://api.seudominio.com/v1/webhooks/abacatepay
# ---------------------------------------------------------------------------
ABACATEPAY_API_KEY=
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
#  Web app build — INLINED AT BUILD TIME. After changing any of these, rebuild
#  the web image:  docker compose build web   (or `make rebuild-web`).
#
#  Default routes API calls same-origin through nginx (/api -> backend), so no
#  CORS and nothing else to set locally. For a split prod deployment set this
#  to the API's own URL, e.g. https://api.seudominio.com
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DATA_MODE=remote
EXPO_PUBLIC_API_URL=http://localhost:8081/api
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
#  Native device testing (profile: native). LAN_HOST must be THIS machine's
#  IP on the Wi-Fi the phone is on (ipconfig / ip addr). Then:
#    make native        (or: docker compose --profile native up -d)
#  and open  exp://<LAN_HOST>:<METRO_PORT>  in Expo Go.
#  EXPO_PUBLIC_API_URL_NATIVE points the device at the API over the LAN
#  (localhost on the phone is the phone itself). Use the same LAN_HOST value.
# ---------------------------------------------------------------------------
LAN_HOST=192.168.0.10
EXPO_PUBLIC_API_URL_NATIVE=http://192.168.0.10:3333
