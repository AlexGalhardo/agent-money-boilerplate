{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"types": ["jest", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@/assets/*": ["./assets/*"],
			"@op/shared": ["../shared/src/index.ts"],
			"@op/shared/*": ["../shared/src/*.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"]
}
