# ---------------------------------------------------------------------------
# op mobile — copy to .env. Only EXPO_PUBLIC_* vars reach the app bundle and
# they are inlined at build time (restart Metro after changing this file).
# ---------------------------------------------------------------------------

# local  = offline-first, on-device SQLite is the source of truth (no backend).
#          Use this for quick local testing.
# remote = online-first against the deployed API via TanStack Query.
#          Use this for store builds.
EXPO_PUBLIC_DATA_MODE=local

# Base URL of the op backend (only used when EXPO_PUBLIC_DATA_MODE=remote).
# Android emulator: use http://10.0.2.2:3333 to reach the host machine.
# Physical device: use your machine's LAN IP, e.g. http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
EXPO_PUBLIC_API_VERSION=v1

# OAuth 2.0 client IDs for "Sign in with Google" (optional; from
# https://console.cloud.google.com/apis/credentials). The backend validates the
# ID token against its own GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
