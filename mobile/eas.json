{
	"cli": {
		"version": ">=24.7.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://moneyzin-backend.up.railway.app"
			}
		},
		"production": {
			"autoIncrement": true,
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://moneyzin-backend.up.railway.app"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./google-play-service-account.json",
				"track": "internal"
			}
		}
	}
}
