# https://editorconfig.org

root = true

[*]
indent_style = tab
charset = utf-8
end_of_line = lf
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# YAML forbids tabs, and Markdown list/code indentation renders
# inconsistently with them across GitHub, editors and Prettier.
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
