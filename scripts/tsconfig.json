{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["@types/bun"],
		"lib": ["ESNext", "DOM"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"jsx": "react-jsx"
	},
	"include": ["dev.ts", "qa.ts"]
}
