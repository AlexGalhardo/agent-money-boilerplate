{
	"name": "@agentic-personal-finances/backend",
	"private": true,
	"type": "module",
	"version": "1.2.0",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run --watch src/server.ts",
		"start": "bun run src/server.ts",
		"build": "bun run db:generate && bun build --compile --minify ./src/server.ts --outfile server",
		"build:postgres": "bun run db:generate:postgres && bun build --compile --minify ./src/server.ts --outfile server",
		"pretest": "bun run test:setup",
		"test": "bun test",
		"test:setup": "bun run scripts/reset-test-db.ts && DATABASE_URL=file:./test.db DATABASE_PROVIDER=sqlite prisma7 migrate deploy && DATABASE_URL=file:./test.db DATABASE_PROVIDER=sqlite prisma7 generate",
		"test:unit": "bun test src/**/*.unit.test.ts",
		"test:integration": "bun run test:setup && bun test src/**/*.integration.test.ts",
		"db:generate": "DATABASE_URL=file:./dev.db DATABASE_PROVIDER=sqlite bunx prisma7 generate",
		"db:generate:postgres": "DATABASE_URL=postgresql://unused@localhost/unused DATABASE_PROVIDER=postgresql bunx prisma7 generate",
		"db:migrate": "bunx prisma7 migrate dev",
		"db:migrate:postgres": "DATABASE_PROVIDER=postgresql bunx prisma7 migrate dev",
		"db:deploy": "bunx prisma7 migrate deploy",
		"db:deploy:postgres": "DATABASE_PROVIDER=postgresql bunx prisma7 migrate deploy",
		"db:seed": "bun run prisma/seed.ts",
		"db:studio": "bunx prisma7 studio",
		"cron:check-expired-plans": "bun run scripts/check-expired-plans.ts",
		"test:e2e:setup": "bun run scripts/reset-e2e-db.ts && DATABASE_URL=file:./e2e.db DATABASE_PROVIDER=sqlite prisma7 migrate deploy && DATABASE_URL=file:./e2e.db DATABASE_PROVIDER=sqlite prisma7 generate && bun --env-file=.env.e2e run prisma/seed.ts",
		"start:e2e": "bun --env-file=.env.e2e run src/server.ts"
	},
	"dependencies": {
		"@agentic-personal-finances/core": "workspace:*",
		"@better-auth/api-key": "1.7.15",
		"@better-auth/expo": "1.7.15",
		"@elysia/bearer": "2.0.0-rc.0",
		"@elysia/cors": "2.0.0-rc.0",
		"@elysia/eden": "2.0.0-rc.0",
		"@elysia/openapi": "2.0.0-rc.0",
		"@galhardoalex/telegram-logger": "1.0.1",
		"@libsql/client": "0.18.0",
		"@prisma/adapter-libsql": "7.10.1",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.2.0",
		"better-auth": "1.7.15",
		"elysia": "2.0.0-rc.0",
		"pg": "8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-email": "6.11.6",
		"resend": "6.37.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.20",
		"@prisma/orm-sqlite": "8.0.0-rc.20",
		"@prisma/prisma7": "7.10.1",
		"@types/bun": "1.4.4",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"prisma": "8.0.0-rc.26"
	}
}
