# Validated at boot by src/config/env.ts — that file is the source of truth.
NODE_ENV=development
PORT=4000
# Public URL of this API (webhooks are registered against it)
APP_URL=http://localhost:4000
# Public URL of the web frontend (CORS origin, auth redirects, e-mail links)
FRONTEND_URL=http://localhost:4001

# sqlite (local default) or postgresql
DATABASE_PROVIDER=sqlite
# sqlite:   file:./dev.db
# postgres: postgresql://postgres:postgres@localhost:5432/finances
DATABASE_URL=file:./dev.db

# openssl rand -hex 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>

# openssl rand -hex 32 (32 bytes / 64 hex chars — AES-256-GCM key that
# encrypts every transaction; losing it makes existing data unreadable)
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# --- feature flags (off by default for local dev) ---
ENABLE_CONFIRM_EMAIL=false
ENABLE_2FA=false
ENABLE_ABACATEPAY=false

# --- social login (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- transactional e-mail (Resend + react-email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- PIX payments (AbacatePay API v2) ---
ABACATEPAY_API_KEY=
# checked against the ?webhookSecret= query param of /webhook/abacatepay
ABACATEPAY_WEBHOOK_SECRET=
# enables the "Pay PIX Test Mode" button and the payment simulation
# endpoint (sandbox/devMode) — never enable in production
ABACATEPAY_PIX_TEST_MODE=false

# --- cron routes (/cron/*) — sent as "Authorization: Bearer <CRON_SECRET>" ---
CRON_SECRET=

# --- optional: `bun run db:seed` also creates this personal account ---
SEED_PERSONAL_EMAIL=
SEED_PERSONAL_PASSWORD=
SEED_PERSONAL_NAME=
