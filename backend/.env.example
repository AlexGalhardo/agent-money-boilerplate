NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:4001

# sqlite (padrão local) ou postgresql
DATABASE_PROVIDER=sqlite
# sqlite:  file:./dev.db
# postgres: postgresql://postgres:postgres@localhost:5432/finances
DATABASE_URL=file:./dev.db

# openssl rand -hex 32
BETTER_AUTH_SECRET=<gere-com-openssl-rand-hex-32>

# openssl rand -hex 32 (32 bytes / 64 caracteres hex — usado em AES-256-GCM)
ENCRYPTION_KEY=<gere-com-openssl-rand-hex-32>

# --- feature flags (desativadas por padrão para dev local) ---
ENABLE_CONFIRM_EMAIL=false
ENABLE_2FA=false
ENABLE_ABACATEPAY=false

# --- login social (Google) ---
GOOGLE_CLIENT_ID=<seu-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<seu-google-client-secret>
GOOGLE_REDIRECT_URL={APP_url}/dashboard

# --- e-mail transacional (Resend + react-email) ---
RESEND_API_KEY_SANDBOX=<sua-resend-api-key>
RESEND_FROM_EMAIL=onboarding@resend.com

# --- pagamentos PIX (AbacatePay API v2) ---
ABACATEPAY_API_KEY=
# usado para verificar o parâmetro ?webhookSecret= do endpoint
# /webhook/abacatepay registrado na AbacatePay — ver docs/pagamentos.md
ABACATEPAY_WEBHOOK_SECRET=
# habilita o botão "Pagar PIX Teste Mode" e o endpoint de simulação de
# pagamento (sandbox/devMode) — nunca ligar em produção
ABACATEPAY_PIX_TEST_MODE=false
