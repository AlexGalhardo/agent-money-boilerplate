// Prisma doesn't allow a dynamic datasource provider (env()), so there is
// one schema per database (SQLite for lightweight local dev, Postgres for
// full local dev and production). Models here must stay identical to the
// other schema file — replicate every model change in both. Selected via
// DATABASE_PROVIDER in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  planStatus       String    @default("inactive")
  planExpiresAt    DateTime?
  telegramChatId       String?   @unique
  freeTransactionCount Int       @default(0)
  deletionRequestedAt  DateTime?
  // Strong password generated for Google-only accounts (see
  // databaseHooks.account.create in src/lib/auth.ts), ENCRYPTED at rest with
  // ENCRYPTION_KEY, so "Minha conta" can show it. Cleared as soon as the user
  // sets a password of their own.
  autoGeneratedPassword String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  transactions Transaction[]
  twoFactor    TwoFactor?
  paymentLogs  PaymentLog[]
  pixCharges   PixCharge[]
  apiKeys      Apikey[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// better-auth 2FA plugin table. Only populated with ENABLE_2FA=true, but
/// the model always exists so the schema never needs a conditional migration.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Columns required by the installed better-auth twoFactor plugin (see
  // node_modules/better-auth/dist/plugins/two-factor/schema.mjs) — without
  // them better-auth refuses to boot with "Prisma schema mismatch".
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@map("two_factor")
}

/// description and amount are encrypted (AES-256-GCM) in the application
/// layer before being persisted — see src/lib/encryption.ts. amount is an
/// integer number of cents once decrypted.
model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      String
  category    String
  type        String
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?

  @@index([userId])
  @@index([userId, category])
  @@map("transaction")
}

/// AbacatePay event/webhook log (charge created, confirmed, failed) for
/// billing audit. Not used by the plan-expiry cron (which only reads
/// User.planStatus/planExpiresAt).
model PaymentLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String   @unique
  eventType  String
  status     String
  amount     Int?
  currency   String?
  rawPayload String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("payment_log")
}

/// PIX charge created through AbacatePay (Transparent Checkout v2). The
/// webhook confirms payment asynchronously; GET /payments/pix/:id/status also
/// polls AbacatePay directly as a fallback, since webhooks need a public
/// HTTPS endpoint (they never reach localhost without a tunnel).
model PixCharge {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId    String    @unique
  plan          String
  amount        Int
  status        String    @default("pending")
  brCode        String
  brCodeBase64  String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("pix_charge")
}

/// @better-auth/api-key plugin table (developer API). The lowercase model
/// name ("Apikey") is deliberate — better-auth's Prisma adapter resolves the
/// model by its internal name "apikey" (client.apikey), not "apiKey".
model Apikey {
  id                  String    @id @default(uuid())
  configId            String
  name                String?
  start               String?
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([referenceId])
  @@index([configId])
  @@index([key])
  @@map("api_key")
}

/// Single-use token for linking a Telegram chat through a web login (e.g.
/// Google): the bot can't run OAuth inside the chat, so it sends a link with
/// this token and the backend links the chat once the user is authenticated
/// on that page. No relation to User: the link (User.telegramChatId) is only
/// decided when the token is redeemed.
model TelegramLinkToken {
  token     String   @id
  chatId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("telegram_link_token")
}
