// Prisma nao permite que o "provider" do datasource seja dinamico (env()),
// entao mantemos um schema por banco (SQLite para dev local leve, Postgres
// para dev local completo e producao). Os models abaixo devem ficar
// identicos ao schema.postgresql.prisma — qualquer mudanca de model precisa
// ser replicada nos dois arquivos. Selecionado via DATABASE_PROVIDER em
// prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  planStatus       String    @default("inactive")
  planExpiresAt    DateTime?
  telegramChatId       String?   @unique
  freeTransactionCount Int       @default(0)
  deletionRequestedAt  DateTime?
  // Senha forte gerada automaticamente para contas criadas só via Google
  // (ver databaseHooks.account.create em src/lib/auth.ts) — permite mostrar
  // a "senha atual" pré-preenchida em Minha Conta. Zerada assim que o
  // usuário define uma senha própria (databaseHooks.account.update).
  autoGeneratedPassword String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  transactions Transaction[]
  twoFactor    TwoFactor?
  paymentLogs  PaymentLog[]
  pixCharges   PixCharge[]
  apiKeys      Apikey[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Tabela usada pelo plugin de 2FA do better-auth. So e populada quando
/// ENABLE_2FA=true, mas o model existe sempre para nao exigir migracao
/// condicional de schema.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Colunas exigidas pelo plugin twoFactor do better-auth a partir da
  // versao instalada (ver node_modules/better-auth/dist/plugins/two-factor/schema.mjs) —
  // sem elas o better-auth recusa subir com "Prisma schema mismatch".
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@map("two_factor")
}

/// description e amount sao criptografados (AES-256-GCM) na camada de
/// aplicacao antes de persistir — ver src/lib/encryption.ts. amount
/// representa centavos (Int) depois de descriptografado.
model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      String
  category    String
  type        String
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?

  @@index([userId])
  @@index([userId, category])
  @@map("transaction")
}

/// Log de eventos/webhooks da AbacatePay (criacao de cobranca, confirmacao,
/// falha), usado para auditoria de cobranca. Nao usado pelo cronjob de
/// verificacao de plano (que so olha User.planStatus/planExpiresAt).
model PaymentLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String   @unique
  eventType  String
  status     String
  amount     Int?
  currency   String?
  rawPayload String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("payment_log")
}

/// Cobranca PIX criada via AbacatePay (Checkout Transparente /v2). O
/// webhook confirma o pagamento de forma assincrona; GET
/// /payments/pix/:id/status tambem reconsulta a AbacatePay diretamente como
/// fallback, ja que webhooks exigem endpoint HTTPS publico (nao alcancam
/// localhost em dev sem tunel).
model PixCharge {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId    String    @unique
  plan          String
  amount        Int
  status        String    @default("pending")
  brCode        String
  brCodeBase64  String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("pix_charge")
}

/// Tabela usada pelo plugin @better-auth/api-key (Fase 4 — API para
/// desenvolvedores). Nome do model em minusculas ("Apikey") de proposito —
/// o adaptor Prisma do better-auth resolve o model pelo nome interno "apikey"
/// (client.apikey), nao "apiKey".
model Apikey {
  id                  String    @id @default(uuid())
  configId            String
  name                String?
  start               String?
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([referenceId])
  @@index([configId])
  @@index([key])
  @@map("api_key")
}

/// Token de uso unico para vincular um chat do Telegram a uma conta via
/// login web (ex: Google) — o bot nao consegue fazer OAuth dentro do chat,
/// entao gera esse token, manda um link pro navegador, e o backend resolve
/// o vinculo quando o usuario completa o login autenticado nessa pagina.
/// Sem relation com User: o vinculo (User.telegramChatId) so e decidido no
/// momento em que o token e resgatado.
model TelegramLinkToken {
  token     String   @id
  chatId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("telegram_link_token")
}
