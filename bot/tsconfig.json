{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["@types/bun"],
		"lib": ["ESNext"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowJs": false,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["src", "scripts"]
}
