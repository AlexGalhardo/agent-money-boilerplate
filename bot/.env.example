# O bot importa prisma/encrypt/decrypt/paymentService de
# @elysia-galhardo-finances/backend, então precisa das MESMAS variáveis do
# backend/.env (mesmo banco, mesma chave de criptografia) — copie os valores de
# backend/.env para as linhas abaixo. Desde a Fase 9 o bot é multi-tenant: cada
# chat se vincula à própria conta enviando o ID dela (ver docs/telegram-bot.md),
# não existe mais um "usuário pessoal" fixo nem um chat único permitido.
NODE_ENV=development
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:../backend/dev.db

# openssl rand -hex 32 (mesmo valor de BETTER_AUTH_SECRET do backend/.env —
# não é usado pelo bot, mas o módulo de config da API exige que exista)
BETTER_AUTH_SECRET=<gere-com-openssl-rand-hex-32>

# mesmo valor de ENCRYPTION_KEY do backend/.env — obrigatório, é a chave usada
# para descriptografar/criptografar as transações
ENCRYPTION_KEY=<gere-com-openssl-rand-hex-32>

# --- específico do bot ---

# token do @BotFather
TELEGRAM_BOT_TOKEN=<token-do-botfather>

# hash bcrypt da sua senha pessoal, em base64 — gere com:
# bun run hash-password "sua-senha"
# (base64 porque um hash bcrypt tem "$" literais, e tanto o Bun quanto o
# Docker Compose tentam expandir "$" como variável de ambiente ao ler .env)
BOT_PASSWORD_HASH_BASE64=<hash-bcrypt-em-base64>

# tentativas de senha erradas seguidas antes de bloquear temporariamente
BOT_MAX_ATTEMPTS=5

# duração do bloqueio, em minutos, após exceder BOT_MAX_ATTEMPTS
BOT_LOCKOUT_MINUTES=15

# feature flag: exige a senha pessoal (BOT_PASSWORD_HASH_BASE64) antes de
# cada transação/consulta feita pelo bot (despesa, receita, resumo, buscar,
# apagar, relatório). Padrão false — não pede senha nenhuma dessas ações.
TELEGRAM_BOT_USE_PASSWORD_TO_CONFIRM_ACTIONS=false

# --- pagamentos PIX no chat (mesmos valores de backend/.env — Fase 9) ---
ENABLE_ABACATEPAY=false
ABACATEPAY_API_KEY=
ABACATEPAY_PIX_TEST_MODE=false
