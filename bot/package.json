{
	"name": "@elysia-galhardo-finances/bot",
	"private": true,
	"version": "0.0.1-alpha",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun --env-file=.env.test test",
