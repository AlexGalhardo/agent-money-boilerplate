{
	"name": "@agentic-personal-finances/bot",
	"private": true,
	"type": "module",
	"version": "1.2.0",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"build": "bun build --compile --minify ./src/index.ts --outfile bot",
		"test": "bun --env-file=.env.test test",
		"test:unit": "bun --env-file=.env.test test src/**/*.unit.test.ts",
		"hash-password": "bun run scripts/hash-password.ts"
	},
	"dependencies": {
		"@agentic-personal-finances/core": "workspace:*",
		"@agentic-personal-finances/backend": "workspace:*",
		"@galhardoalex/telegram-logger": "1.0.1",
		"@grammyjs/conversations": "2.1.1",
		"bcryptjs": "3.0.3",
		"better-auth": "1.7.15",
		"grammy": "1.46.0",
		"pdfkit": "0.20.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/pdfkit": "0.17.7"
	}
}
